[Unit]
Description=XUI One Task Queue Processor
Documentation=https://github.com/TalaveraSama/IUX-ZONE
After=network.target mysql.service redis.service
Wants=mysql.service redis.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/xui/decoded
ExecStart=/usr/bin/php includes/cli/queue.php

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/xui/tmp /var/www/xui/config
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xui-queue

[Install]
WantedBy=multi-user.target